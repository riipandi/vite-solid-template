{
  "name": "vite-solid-template",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "start": "pnpm dlx serve dist/client -l 3000 -s -n -C",
    "check": "oxlint -c oxlint.config.mjs --fix && oxfmt --check .",
    "format": "oxfmt --write .",
    "lint": "oxlint -c oxlint.config.mjs src",
    "update-deps": "npm-check-updates --configFileName .ncurc.json",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry -o storybook-static",
    "storybook:preview": "pnpm dlx serve storybook-static -l 6006 -n -C",
    "cleanup:dev": "pnpm dlx rimraf dist storybook-static tests-results",
    "pre-commit": "lefthook run pre-commit --force",
    "prepare": "lefthook install || true",
    "test:report": "pnpm dlx serve tests-results -l 8000 -s -n -C",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test": "vitest --run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.16",
    "@solidjs/web": "^2.0.0-rc.2",
    "solid-js": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@solidjs/vite-plugin": "^3.0.0-next.33",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "eslint-plugin-solid": "~0.16.0",
    "filesystem-routing": "0.2.1",
    "jsdom": "^30.0.1",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
