{
    "name": "vite-solid-template",
    "version": "0.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "serve": "vite preview",
        "start": "node --env-file-if-exists=.env.local server.js",
        "check": "oxfmt --check && oxlint",
        "format": "oxfmt --write .",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit",
        "e2e:install": "playwright install --with-deps",
        "e2e:chrome": "playwright test --headed --project Chromium",
        "e2e:firefox": "playwright test --headed --project Firefox",
        "e2e:mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e:safari": "playwright test --headed --project Safari",
        "e2e:report": "playwright show-report .output/e2e-result",
        "e2e:ui": "playwright test --ui",
        "e2e": "playwright test",
        "coverage:report": "pnpm dlx node-http-server --root .output/coverage --port 8000 --spa --no-cache",
        "coverage": "vitest run --coverage",
        "test": "vitest --run"
    },
    "dependencies": {
        "@solidjs/meta": "^1.0.0-next.2",
        "@solidjs/router": "^2.0.0-next.38",
        "@solidjs/web": "^2.0.0-rc.14",
        "solid-js": "^2.0.0-rc.14"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@solidjs/diagnostics": "^2.0.0-rc.14",
        "@solidjs/start-devtools": "^1.0.0-next.4",
        "@solidjs/testing-library": "^1.0.0-beta.3",
        "@solidjs/vite-plugin": "^3.0.0-next.50",
        "@testing-library/jest-dom": "^7.0.0",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "eslint-plugin-solid": "~0.18.1",
        "filesystem-routing": "0.4.0",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.22.0"
    }
}
