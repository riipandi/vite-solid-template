{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "ignorePatterns": [
    ".git",
    "dist",
    "public",
    "node_modules",
    "storybook-static",
    "tests-results",
    "file-routes.d.ts"
  ],
  "sortTailwindcss": {
    "tailwindStylesheet": "./src/styles/globals.css",
    "functions": ["cn", "clx", "clsx", "cva", "tw"]
  }
}
